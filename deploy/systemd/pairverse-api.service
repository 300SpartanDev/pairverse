[Unit]
Description=Pairverse public API + Liquidity Universe site
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pairverse
Group=pairverse
WorkingDirectory=/opt/pairverse
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/pairverse
Environment=PAIRS_DB=/var/lib/pairverse/pairs.db
Environment=PAIRS_CACHE=/var/lib/pairverse/cache
ExecStart=/opt/pairverse/.venv/bin/python -m uvicorn api:app --host 127.0.0.1 --port 8765 --app-dir /opt/pairverse --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
# open SSE streams otherwise hold a graceful stop for the default 90 s
TimeoutStopSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
