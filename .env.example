# Pairverse configuration. Copy to .env (never commit .env) or set these in your
# systemd unit / docker compose file. Everything is optional.

# Where the SQLite database and the derived cache live (default: next to the code)
# PAIRS_DB=/var/lib/pairverse/pairs.db
# PAIRS_CACHE=/var/lib/pairverse/cache

# Token logos: thumbnail cache dir (default: <cache parent>/img) and its size cap in MB
# PAIRS_IMG_DIR=/var/lib/pairverse/img
# PAIRS_IMG_CAP_MB=4096
# Solana RPC used to read on-chain token metadata for logos (default: public mainnet RPC,
# or the Helius RPC when HELIUS_API_KEY is set)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional Cloudflare quick tunnel when running locally with ./start.sh (needs bin/cloudflared)
# PAIRS_TUNNEL=1

# Optional: your own Helius API key (free tier or paid plan: https://www.helius.dev)
# Enables Helius DAS getAsset token metadata during enrichment and a Helius RPC URL.
# Leave unset to run on the free public sources only.
# HELIUS_API_KEY=

# Self-host (deploy/install-host.sh, deploy/install-docker.sh)
# CADDY_EMAIL=you@example.com
# PAIRVERSE_DOMAIN=example.com
